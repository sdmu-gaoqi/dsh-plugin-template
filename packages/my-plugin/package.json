{
  "name": "dsh-my-plugin",
  "version": "0.1.0",
  "description": "dsh 插件模板：TypeScript 源码 + node 端与浏览器端双入口",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../build/bin/build.mjs --package .",
    "dev": "node ../build/bin/build.mjs --package . --watch",
    "typecheck": "node ../build/bin/build.mjs --package . --typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
